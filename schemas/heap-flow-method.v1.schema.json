          "type": "array"
        },
        "location_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Location Refs",
          "type": "array"
        },
        "binding_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
