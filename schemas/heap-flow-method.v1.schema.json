        "kind": {
          "enum": [
            "parameter",
            "receiver",
            "caught_exception",
            "constant",
            "call_result",
            "heap_read",
            "allocation",
            "undefined_local",
            "unsupported_expression",
            "incomplete_operand",
            "opaque_result"
