      "required": [
        "unit",
        "unit_ref",
        "operation",
        "storage_kind",
        "field_signature",
        "index",
        "unknown_index",
        "objects",
        "unknown_base",
        "base_endpoint",
        "origin_paths",
        "location_refs",
        "binding_refs",
        "write_value",
        "strong_update",
        "issues"
