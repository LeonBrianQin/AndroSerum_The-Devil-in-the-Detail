{
  "$defs": {
    "AnalysisNodeRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "run_ref": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Run Ref",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "kind": {
          "const": "analysis_node",
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "discriminator": {
            "mapping": {
              "analysis": "#/$defs/AnalysisPosition",
              "model": "#/$defs/ModelPosition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AnalysisPosition"
            },
            {
              "$ref": "#/$defs/ModelPosition"
            }
          ],
          "title": "Position"
        },
        "node_kind": {
          "enum": [
            "jimple",
            "cfg",
            "object",
            "state",
            "entry",
            "event",
            "mapping"
          ],
          "title": "Node Kind",
          "type": "string"
        },
        "method_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Ref"
        },
        "text": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/ProgramSlot"
          },
          "title": "Slots",
          "type": "array"
        }
      },
      "required": [
        "id",
        "run_ref",
        "provenance",
        "kind",
        "position",
        "node_kind"
      ],
      "title": "AnalysisNodeRecord",
      "type": "object"
    },
    "AnalysisPosition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analysis",
          "title": "Kind",
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Path",
          "type": "string"
        },
        "position_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Position Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_path",
        "position_label"
      ],
      "title": "AnalysisPosition",
      "type": "object"
    },
    "BindingRecord": {
      "additionalProperties": false,
