            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Ref"
        },
        "location": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "analysis": "#/$defs/AnalysisPosition",
                  "archive": "#/$defs/ArchivePosition",
                  "dex_declaration": "#/$defs/DexDeclarationPosition",
                  "dex_instruction": "#/$defs/InstructionPosition",
                  "model": "#/$defs/ModelPosition"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ArchivePosition"
                },
                {
                  "$ref": "#/$defs/DexDeclarationPosition"
                },
                {
                  "$ref": "#/$defs/InstructionPosition"
                },
                {
                  "$ref": "#/$defs/AnalysisPosition"
                },
                {
                  "$ref": "#/$defs/ModelPosition"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AnalysisScope",
      "type": "object"
    },
    "AnalysisStatus": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "run_ref": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
