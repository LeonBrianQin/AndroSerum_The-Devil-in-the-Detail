        "issue_code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Code"
        }
      },
      "required": [
        "id",
        "run_ref",
        "tool_ref",
        "capability",
        "scope",
        "state"
      ],
      "title": "AnalysisStatus",
      "type": "object"
