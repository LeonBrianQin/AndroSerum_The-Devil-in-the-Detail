          "type": "string"
        },
        "tool_ref": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Tool Ref",
          "type": "string"
        },
        "capability": {
          "enum": [
            "dex",
            "manifest",
            "resources",
            "dex_jimple_mapping",
            "data_flow",
            "calls",
            "objects",
            "control",
            "events"
          ],
          "title": "Capability",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "not_started",
            "unavailable",
            "failed",
            "truncated"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
