{
  "$defs": {
    "AnalysisNodeRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "run_ref": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Run Ref",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "kind": {
          "const": "analysis_node",
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "discriminator": {
            "mapping": {
              "analysis": "#/$defs/AnalysisPosition",
              "model": "#/$defs/ModelPosition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AnalysisPosition"
            },
            {
              "$ref": "#/$defs/ModelPosition"
            }
          ],
          "title": "Position"
        },
        "node_kind": {
          "enum": [
            "jimple",
            "cfg",
            "object",
            "state",
            "entry",
            "event",
            "mapping"
          ],
          "title": "Node Kind",
          "type": "string"
        },
        "method_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Ref"
        },
        "text": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/ProgramSlot"
          },
          "title": "Slots",
          "type": "array"
        }
      },
      "required": [
        "id",
        "run_ref",
        "provenance",
        "kind",
        "position",
        "node_kind"
      ],
      "title": "AnalysisNodeRecord",
      "type": "object"
    },
    "AnalysisPosition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analysis",
          "title": "Kind",
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Path",
          "type": "string"
        },
        "position_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Position Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_path",
        "position_label"
      ],
      "title": "AnalysisPosition",
      "type": "object"
    },
    "AnalysisRun": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "program-facts.v1",
          "default": "program-facts.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "id_version": {
          "const": "program-id.v1",
          "default": "program-id.v1",
          "title": "Id Version",
          "type": "string"
        },
        "input_kind": {
          "enum": [
            "apk",
            "synthetic"
          ],
          "title": "Input Kind",
          "type": "string"
        },
        "apk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Apk Sha256",
          "type": "string"
        },
        "apk_size_bytes": {
          "minimum": 0,
          "title": "Apk Size Bytes",
          "type": "integer"
        },
        "input_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Input Name",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "minItems": 1,
          "title": "Tools",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/VersionedArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "configuration": {
          "$ref": "#/$defs/FactConfig"
        },
        "config_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "input_kind",
        "apk_sha256",
        "apk_size_bytes",
        "input_name",
        "created_at",
        "tools",
        "configuration",
        "config_fingerprint"
      ],
      "title": "AnalysisRun",
      "type": "object"
    },
    "AnalysisScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "run",
            "element",
            "location"
          ],
          "title": "Kind",
          "type": "string"
